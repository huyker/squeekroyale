# Copy to contracts/.env and fill in. NEVER commit .env.
# Sepolia RPC (public endpoint works; an Alchemy/Infura URL is more reliable)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployer / owner key of a TESTNET-ONLY wallet funded with Sepolia ETH
DEPLOYER_PRIVATE_KEY=
# Operator key used by scripts/operator.mjs to lock/seed/settle arenas (can be the same wallet)
OPERATOR_PRIVATE_KEY=
# Local Hardhat node (chain 31337): the dev phrase / account #0 key that `npx hardhat node` prints.
# Used by scripts/demo-local.mjs, scripts/autopilot.mjs (--dev-wallets, auto-fund) and scripts/operator.mjs --network localhost.
LOCAL_DEV_MNEMONIC=
OPERATOR_PRIVATE_KEY_LOCAL=
